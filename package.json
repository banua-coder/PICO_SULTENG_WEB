{
  "name": "pico-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build",
    "preview": "vite preview",
    "lint": "eslint . && pnpm lint:tokens && pnpm check:brand",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "fixtures:check": "tsx scripts/record-fixtures.ts --check",
    "sync:brand": "node scripts/sync-brand.mjs",
    "check:brand": "node scripts/sync-brand.mjs --check",
    "lint:tokens": "tsx scripts/lint-src.ts"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "unhead": "2.1.17",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
