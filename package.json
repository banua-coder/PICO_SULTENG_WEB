{
  "name": "pico-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:data && vite-ssg build && tsx scripts/postbuild.ts",
    "preview": "vite preview",
    "lint": "eslint . && pnpm lint:tokens && pnpm check:i18n && pnpm check:brand",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "fixtures:check": "tsx scripts/record-fixtures.ts --check",
    "sync:brand": "node scripts/sync-brand.mjs",
    "check:brand": "node scripts/sync-brand.mjs --check",
    "lint:tokens": "tsx scripts/lint-src.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "build:geo": "tsx scripts/build-geo.ts",
    "build:data": "tsx scripts/snapshot-kabupaten.ts && tsx scripts/snapshot-home.ts && tsx scripts/snapshot-lastreal.ts && tsx scripts/build-downloads.ts",
    "check:dist": "tsx scripts/check-dist.ts",
    "check:budget": "tsx scripts/check-budget.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.61.0",
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "unhead": "2.1.17",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
